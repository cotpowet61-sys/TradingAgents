# ===== TradeVision Portal — настройки =====
# Файл portal/.env создаётся автоматически при первом запуске.
# Менять всё можно и удобнее через веб-интерфейс (вкладка «Настройки»).

# --- Сервер ------------------------------------------------------------ #
PORTAL_HOST=0.0.0.0
PORTAL_PORT=3005

# --- AI (justcode.lol) -------------------------------------------------- #
# Один глобальный ключ обычно достаточен; можно задать отдельный на роль.
AI_API_KEY=
AI_BASE_URL=https://api.justcode.lol/v1
AI_TIMEOUT=120
AI_MAX_TOKENS=1400
AI_TEMPERATURE=0.3

# Модели по ролям (выбираются в Настройках из списка /api/models)
MODEL_STRATEGIST=gpt-6-astra
MODEL_MOMENTUM=gpt-5.6-sol
MODEL_CONTRARIAN=grok-4.5
MODEL_MACRO=gemini-2.5-pro
MODEL_RISK=claude-fable-5
MODEL_PORTFOLIO=gpt-6-astra

KEY_STRATEGIST=
KEY_MOMENTUM=
KEY_CONTRARIAN=
KEY_MACRO=
KEY_RISK=
KEY_PORTFOLIO=

# Выключатели ролей (false = агент не вызывается, токены не тратятся)
EN_STRATEGIST=true
EN_MOMENTUM=true
EN_CONTRARIAN=true
EN_MACRO=true
EN_RISK=true
EN_PORTFOLIO=true

# --- Bybit -------------------------------------------------------------- #
# Публичные данные (графики/сигналы) работают БЕЗ ключей.
# Для раздела «Мои сделки» создайте в Bybit ключ с правами READ-ONLY
# (Account & API Management → Create → Read-only) и вставьте сюда или в UI.
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_API_KEY=
BYBIT_API_SECRET=
MARKET_CATEGORY=linear

# --- Live-сигналы (индикаторы; AI-токены НЕ тратятся) ------------------- #
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,LSKUSDT
SCAN_INTERVAL_SECONDS=30
DEFAULT_TIMEFRAME=5m
MIN_CONFIDENCE=0.55
SIGNAL_STRATEGY=auto
NOTIFY_SOUND=true
NOTIFY_TOASTS=true
# Привязка правила TP>=2% / SL 1% (RR 2:1). false = цели по ATR графика
RR_BINDING=true
# Таймфреймы сканера через запятую (1m,3m,5m,15m,30m,1h,4h). Пусто = только DEFAULT_TIMEFRAME
SIGNAL_TIMEFRAMES=5m
# Ручной риск-фактор: если TP и SL > 0 — сигналы получают именно эти цели (приоритет над 2:1 и ATR). 0 = выкл
MANUAL_TP_PCT=0.0
MANUAL_SL_PCT=0.0
MANUAL_HOLD_MIN=0.0

# --- Правила дэйтрейдинга ------------------------------------------------ #
# 0 = без лимита
MAX_TRADES_PER_DAY=0
MIN_TP_PCT=2.0
MAX_HOLD_HOURS=4.0
DEFAULT_SL_PCT=1.0

# ---- SaaS-режим продажи подписки (по умолчанию ВЫКЛ) ----
# Включать только на прод-VPS: SAAS_MODE=true
SAAS_MODE=false
BRAND_NAME=TradeVision
PRICE_MONTH_USD=100
# ТОЛЬКО публичные адреса приёма USDT. ПРИВАТНЫЕ КЛЮЧИ СЮДА НИКОГДА!
WALLET_TRC20=
WALLET_BEP20=
BSCSCAN_API_KEY=      # бесплатный ключ api.bscscan.com
TELEGRAM_URL=
SITE_URL=https://your-domain.com   # домен фронта (для TG-бота и ссылок)
# Админ (серверное, в .env не в UI):
ADMIN_TOKEN=        # токен /api/admin/* (партнёры)
TG_BOT_TOKEN=       # @BotFather → /newbot
ADMIN_TG_ID=        # ваш числовой tg id (уведомления о платежах)
PORTAL_AUTH_SECRET= # генерация автоматическая; БЭКАПИТЬ (шифр ключей юзеров)
