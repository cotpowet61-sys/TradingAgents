# ===== TradeVision Portal — настройки =====
# Файл portal/.env создаётся автоматически при первом запуске из этого шаблона.
# Менять всё можно и удобнее через веб-интерфейс (вкладка «Настройки»).
#
# ВАЖНО: значения здесь должны совпадать с дефолтами кода (portal_config.py).
# Иначе «скопировал пример как есть» даёт поведение, которого вы не ждали.

# --- Сервер ------------------------------------------------------------ #
# 127.0.0.1 — наружу через reverse-proxy (рекомендуется). 0.0.0.0 — если портал
# слушает напрямую (Docker-проброс, тестовый стенд): тогда TRUST_PROXY_HEADERS=false.
PORTAL_HOST=127.0.0.1
PORTAL_PORT=3005

# --- AI (justcode.lol или любой OpenAI-совместимый endpoint) ----------- #
# Один глобальный ключ обычно достаточен; можно задать отдельный на роль.
# Пусто = режим демо: агенты отвечают по индикаторам, токены не тратятся.
AI_API_KEY=
AI_BASE_URL=https://api.justcode.lol/v1
AI_TIMEOUT=120
AI_MAX_TOKENS=1400
AI_TEMPERATURE=0.3

# Модели по ролям (выбираются в Настройках из списка /api/models)
MODEL_STRATEGIST=gpt-6-astra
MODEL_MOMENTUM=gpt-5.6-sol
MODEL_CONTRARIAN=grok-4.5
MODEL_MACRO=gemini-2.5-pro
MODEL_RISK=claude-fable-5
MODEL_PORTFOLIO=gpt-6-astra

KEY_STRATEGIST=
KEY_MOMENTUM=
KEY_CONTRARIAN=
KEY_MACRO=
KEY_RISK=
KEY_PORTFOLIO=

# Выключатели ролей (false = агент не вызывается, токены не тратятся)
EN_STRATEGIST=true
EN_MOMENTUM=true
EN_CONTRARIAN=true
EN_MACRO=true
EN_RISK=true
EN_PORTFOLIO=true

# --- Bybit -------------------------------------------------------------- #
# Публичные данные (графики/сигналы) работают БЕЗ ключей.
# Для раздела «Мои сделки» создайте в Bybit ключ с правами READ-ONLY
# (Account & API Management → Create → Read-only) и вставьте сюда или в UI.
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_API_KEY=
BYBIT_API_SECRET=
MARKET_CATEGORY=linear

# --- Live-сигналы (индикаторы; AI-токены НЕ тратятся) ------------------- #
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,LSKUSDT
SCAN_INTERVAL_SECONDS=30
# Лестница интервалов сканирования (сек) через запятую: 30,60,90 = адаптивный
# ритм (активный рынок — чаще). Пусто = фиксированный SCAN_INTERVAL_SECONDS.
SCAN_CADENCE_SECONDS=30,60,90
# Сколько таймфреймов просматривать за один проход (ротация по кругу).
TFS_PER_TICK=1
DEFAULT_TIMEFRAME=5m
# Таймфреймы сканера через запятую (1m,3m,5m,15m,30m,1h,4h). Пусто = только DEFAULT_TIMEFRAME
SIGNAL_TIMEFRAMES=5m
MIN_CONFIDENCE=0.55
SIGNAL_STRATEGY=auto
NOTIFY_SOUND=true
NOTIFY_TOASTS=true
# Привязка правила TP>=2% / SL 1% (RR 2:1). false = цели по ATR графика.
# Дефолт кода — false (плавающие цели); true включайте осознанно.
RR_BINDING=false
# Ручной риск-фактор: если TP и SL > 0 — сигналы получают именно эти цели (приоритет над 2:1 и ATR). 0 = выкл
MANUAL_TP_PCT=0.0
MANUAL_SL_PCT=0.0
MANUAL_HOLD_MIN=0.0
# Жёсткий стоп на синтетике: если биржа недоступна, сканер НЕ выдаёт сигналы
# (иначе «учебный график» попадёт в обучение и в публичный трек-рекорд).
REQUIRE_REAL_DATA=true

# --- Размер позиции (отображение в сигнале) ----------------------------- #
DEPOSIT_USD=1000
RISK_PER_TRADE_PCT=3
LEVERAGE=20

# --- Правила дэйтрейдинга ------------------------------------------------ #
# 0 = без лимита
MAX_TRADES_PER_DAY=0
MIN_TP_PCT=0.5
MAX_HOLD_HOURS=4.0
DEFAULT_SL_PCT=1.0

# --- Бэктест (анти-DoS: тяжёлые прогоны ограничены) --------------------- #
BACKTEST_MAX_DAYS=180
BACKTEST_MAX_SYMBOLS=6
BACKTEST_MAX_TFS=3
BACKTEST_TIMEOUT_SEC=180

# --- Безопасность -------------------------------------------------------- #
# CSP/nosniff/referrer-policy и прочие заголовки на каждый ответ
SECURITY_HEADERS=true
# Небезопасные методы (POST/PUT/DELETE) принимаются только с нашего Origin — анти-CSRF
CSRF_ORIGIN_CHECK=true
HSTS_ENABLED=true
# ВНИМАНИЕ: X-Forwarded-For учитывается, только если впереди свой прокси (Caddy).
# Портал, выставленный в интернет НАПРЯМУЮ, обязан иметь false — иначе IP и
# rate-limit подделываются заголовком.
TRUST_PROXY_HEADERS=true
# CSP frame-ancestors: кто может встраивать портал в iframe.
# 'self' — только сам портал; для партнёрских превью добавьте домены.
FRAME_ANCESTORS='self'
# Доп. разрешённые Origin'ы через запятую (партнёрские зеркала, превью-домены)
ALLOWED_ORIGINS=
# Лимит тела запроса, МБ (CSV сделок идёт одним куском)
MAX_BODY_MB=12
# AI-эндпоинты требуют активной подписки (SaaS). false = «триал» AI без оплаты.
REQUIRE_SUB_FOR_AI=true
# Аварийный флаг для локальной отладки: НЕ ставить в боевой .env
UNSAFE_LOCAL=false
# Каталог данных/БД (по умолчанию portal/data). В контейнере: /data
# PORTAL_DATA_DIR=/srv/tradevision/portal/data
# Путь к файлу настроек (по умолчанию portal/.env)
# PORTAL_ENV_FILE=/srv/tradevision/portal/.env

# ---- SaaS-режим продажи подписки --------------------------------------- #
# Режим продажи: регистрация, кабинет /pay.html, оплата, гейтинг доступа.
# ВНИМАНИЕ: при SAAS_MODE=true БЕЗ заполненных кошельков сервер ОТКАЖЕТСЯ
# стартовать (иначе вы запрёте сами себя без возможности оплатить).
SAAS_MODE=false
BRAND_NAME=TradeVision
PRICE_MONTH_USD=100
# ТОЛЬКО публичные адреса приёма USDT. ПРИВАТНЫЕ КЛЮЧИ/SEED СЮДА НИКОГДА!
WALLET_TRC20=
WALLET_BEP20=
BSCSCAN_API_KEY=
# Подтверждение контура watch-only: «в .env только публичные адреса, приватных
# ключей на сервере нет». Нужно, чтобы валидатор старта не выдавал предупреждение.
TRC20_WATCH_ONLY_ACK=false
TELEGRAM_URL=
# Домен фронта (ссылки в TG-боте, Origin-проверка, письма поддержки)
SITE_URL=https://your-domain.com
# Админ-API (партнёры/стата/выплаты). Требуется ≥16 символов; генерируйте случайно.
ADMIN_TOKEN=
# Email(ы) владельцев через запятую: вечный доступ без оплаты
OWNER_EMAILS=
TG_BOT_TOKEN=
ADMIN_TG_ID=
# Секрет подписи сессий и ключ шифрования пользовательских ключей.
# ОБЯЗАТЕЛЕН при SAAS_MODE=true. БЭКАПИТЬ: без него ключи клиентов не расшифруются.
PORTAL_AUTH_SECRET=
# Community-AI: бесплатный провайдер для юзеров без своего ключа (квота 30/день)
FREE_AI_BASE_URL=https://openrouter.ai/api/v1
FREE_AI_KEY=
FREE_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Фоновые процессы можно выключать для отладки/разделения ролей
LIVE_SCANNER=true
BILLING_WATCHER=true
# Хук для тестов/нагрузочных прогонов: не ставить в бой
# RATE_LIMIT_DISABLED=1
