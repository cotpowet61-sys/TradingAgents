# ===================================================================== #
#  TradingAgents — конфигурация (скопируйте в .env и заполните)
# ===================================================================== #

# --- Сервер ---------------------------------------------------------- #
HOST=0.0.0.0
PORT=3001
DEBUG=true

# --- Биржа Bybit (публичные данные; торговые ключи НЕ обязательны) --- #
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false
BYBIT_BASE_URL=https://api.bybit.com

# --- AI-модели: 5 ролей ---------------------------------------------- #
# Глобальный ключ/база (используется, если для роли не задан свой ключ).
# OpenRouter — единая точка доступа ко всем 5 моделям:
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1

# Роль: ведущий стратег
STRATEGIST_MODEL=openai/gpt-6-astra
STRATEGIST_API_KEY=
STRATEGIST_BASE_URL=

# Роль: аналитик моментума/тренда
MOMENTUM_MODEL=openai/gpt-5.6-sol
MOMENTUM_API_KEY=
MOMENTUM_BASE_URL=

# Роль: контрариан / сентимент
CONTRARIAN_MODEL=x-ai/grok-4.5
CONTRARIAN_API_KEY=
CONTRARIAN_BASE_URL=

# Роль: макро / фундаментальный контекст
MACRO_MODEL=google/gemini-2.5-pro
MACRO_API_KEY=
MACRO_BASE_URL=

# Роль: риск-менеджер / финальный арбитр
RISK_MODEL=anthropic/claude-fable-5
RISK_API_KEY=
RISK_BASE_URL=

# --- Риск-менеджмент и правила дэйтрейдинга ------------------------- #
MAX_TRADES_PER_DAY=30
MIN_TP_PCT=2.0
MAX_HOLD_HOURS=4.0
DEFAULT_SL_PCT=1.0
TRADING_FEE_PCT=0.055
INITIAL_CAPITAL=10000
POSITION_SIZE_PCT=10
MIN_CONFIDENCE=0.55
ALLOW_LONG=true
ALLOW_SHORT=true

# --- Рынок / демо-режим --------------------------------------------- #
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,ADAUSDT,LTCUSDT
DEFAULT_TIMEFRAME=5m
SCAN_INTERVAL_SECONDS=30
AUTO_SCAN=true
DEMO_FALLBACK=true
KLINE_LIMIT=500
