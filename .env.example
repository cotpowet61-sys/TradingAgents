# ===================================================================== #
#  TradingAgents — настройки (файл .env)
#  Копия этого файла создаётся автоматически при первом запуске.
#  Все ключи и модели можно также вводить прямо в интерфейсе
#  (вкладка «Настройки») — изменения сохраняются сюда.
# ===================================================================== #

# --- Сервер ---------------------------------------------------------- #
HOST=0.0.0.0
PORT=3003
DEBUG=true

# --- Биржа Bybit (публичные данные; торговые ключи необязательны) --- #
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false
BYBIT_BASE_URL=https://api.bybit.com
# Источник рыночных данных: linear = бессрочные USDT-фьючерсы (по умолчанию),
# spot = спотовый рынок. Монеты без выбранной категории автоматически
# определяются по альтернативной (напр. LSKUSDT есть в фьючерсах, но нет в споте).
MARKET_CATEGORY=linear

# --- AI: единая точка подключения (ваш endpoint) -------------------- #
# Вставьте СЮДА ваш API-ключ — он подставится во все 5 моделей.
AI_API_KEY=
AI_BASE_URL=https://api.justcode.lol/v1

# --- Модели по ролям (имена можно менять) --------------------------- #
STRATEGIST_MODEL=gpt-6-astra
STRATEGIST_API_KEY=
STRATEGIST_BASE_URL=

MOMENTUM_MODEL=gpt-5.6-sol
MOMENTUM_API_KEY=
MOMENTUM_BASE_URL=

CONTRARIAN_MODEL=grok-4.5
CONTRARIAN_API_KEY=
CONTRARIAN_BASE_URL=

MACRO_MODEL=gemini-2.5-pro
MACRO_API_KEY=
MACRO_BASE_URL=

RISK_MODEL=claude-fable-5
RISK_API_KEY=
RISK_BASE_URL=

# --- Риск-менеджмент и правила дэйтрейдинга ------------------------- #
MAX_TRADES_PER_DAY=30
MIN_TP_PCT=2.0
MAX_HOLD_HOURS=4.0
DEFAULT_SL_PCT=1.0
TRADING_FEE_PCT=0.055
INITIAL_CAPITAL=10000
POSITION_SIZE_PCT=10
MIN_CONFIDENCE=0.55
ALLOW_LONG=true
ALLOW_SHORT=true

# --- Рынок / демо-режим --------------------------------------------- #
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,ADAUSDT,LTCUSDT
DEFAULT_TIMEFRAME=5m
SCAN_INTERVAL_SECONDS=30
AUTO_SCAN=true
DEMO_FALLBACK=true
KLINE_LIMIT=500
